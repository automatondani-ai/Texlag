# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Upstash Redis (REST client) ────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Authentication ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Redis Namespace (optional) ────────────────────────────────────────────────
# Prefix all quote-related Redis keys with "{REDIS_NS}:" to isolate tenant data
# when multiple instances share one Redis database.  Leave blank for no prefix.
# Example: REDIS_NS=texlag
REDIS_NS=

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Required. Verified sender address on your Resend domain, e.g. quotes@yourdomain.com
# Falls back to onboarding@resend.dev when unset (Resend test address — delivers to
# your own account only; not suitable for production use).
RESEND_FROM_EMAIL=
# When set, redirects all outbound quote emails to this address (development only).
# Prevents accidental emails to real brokers during testing.
RESEND_TEST_EMAIL=
